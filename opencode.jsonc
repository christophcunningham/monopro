{
  "$schema": "https://opencode.ai/config.json",

  // Main is its own repository with its own remote. It happens to sit inside
  // the monopro_rs checkout, and OpenCode walks up the tree — so this file
  // exists to cancel what the parent's config would otherwise impose here.

  // Cancels the parent's CLAUDE.md / docs list. Those rules describe that
  // checkout, not this one.
  "instructions": [],

  "agent": {
    // The parent denies push because it has no remote. This one does, so the
    // denial is lifted back to the normal prompt-before-running behaviour.
    "lead": {
      "permission": {
        "bash": {
          "*": "ask",
          "cargo test*": "allow",
          "cargo clippy*": "allow"
        }
      }
    },
    "rust-dev": {
      "permission": {
        "bash": {
          "*": "ask",
          "cargo *": "allow",
          "rg *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "git diff*": "allow",
          "git status": "allow"
        }
      }
    }
  }
}
