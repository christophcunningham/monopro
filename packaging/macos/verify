#!/bin/zsh
# Verify the structure and checksum of a macOS candidate package.

set -e

here=${0:A:h}
repo_root=${here:h:h}
version=$(grep -m1 '^version' "$repo_root/Cargo.toml" | sed 's/.*"\(.*\)".*/\1/')
app="$repo_root/dist/monopro.app"
dmg="$repo_root/dist/monopro-$version.dmg"
arm64_only=0
notarized=0
feed=0

while (( $# )); do
  case "$1" in
    --arm64) arm64_only=1 ;;
    --notarized) notarized=1; feed=1 ;;
    --feed) feed=1 ;;
    *) echo "usage: packaging/macos/verify [--arm64] [--notarized | --feed]" >&2; exit 2 ;;
  esac
  shift
done

test -x "$app/Contents/MacOS/monopro"
test -f "$app/Contents/Resources/monopro.icns"
for notice in monopro-GPL-3.0.txt fonts/OFL.txt fonts/AUTHORS.txt \
  icons/LICENSE-Phosphor.txt icons/LICENSE-Lucide.txt profiles/monostar-CC0.txt \
  profiles/eciRGB_v2_license.rtf profiles/licensing-iccorg.txt \
  sparkle/Sparkle-LICENSE.txt sparkle/sparkle-updater-LICENSE-MIT.txt; do
  test -s "$app/Contents/Resources/licenses/$notice"
done
test -f "$dmg"
[[ "$(plutil -extract CFBundleIdentifier raw -o - "$app/Contents/Info.plist")" == \
  "com.christophercunningham.monopro" ]]
[[ "$(plutil -extract CFBundleShortVersionString raw -o - "$app/Contents/Info.plist")" == \
  "$version" ]]
[[ "$(plutil -extract LSMinimumSystemVersion raw -o - "$app/Contents/Info.plist")" == "11.0" ]]

# ── The update machinery ──────────────────────────────────────────────────────
#
# The Sparkle framework must be present, executable, and covered by the bundle's
# signature; the plist must carry the updater's keys (automatic checks stay off
# in a local no-key build — that is the deliberate quiet state, not a defect).
# The ZIP enclosure and its EdDSA signature exist on the publishable paths:
# notarized (--signed) and ad-hoc with a feed (--release).
framework="$app/Contents/Frameworks/Sparkle.framework"
test -d "$framework"
test -x "$framework/Autoupdate"
test -d "$framework/XPCServices"
plutil -extract SUEnableAutomaticChecks raw -o - "$app/Contents/Info.plist" >/dev/null
codesign --verify --deep --strict "$framework"
# The rpath that resolves Contents/Frameworks when dyld loads the framework.
otool -l "$app/Contents/MacOS/monopro" | grep -q '@executable_path/../Frameworks'
zip="$repo_root/dist/monopro-$version-macos.zip"
if (( feed )); then
  feed_url=$(plutil -extract SUFeedURL raw -o - "$app/Contents/Info.plist")
  [[ "$feed_url" == https://* ]] || {
    echo "SUFeedURL is not https: $feed_url" >&2
    exit 1
  }
  [[ -n "$(plutil -extract SUPublicEDKey raw -o - "$app/Contents/Info.plist")" ]]
  plutil -extract SUScheduledCheckInterval raw -o - "$app/Contents/Info.plist" >/dev/null
  test -s "$zip"
  test -s "$zip.ed.sig"
  grep -q 'sparkle:edSignature=' "$zip.ed.sig"
  unzip -l "$zip" | grep -q 'monopro.app/Contents/MacOS/monopro'
fi

archs=$(lipo -archs "$app/Contents/MacOS/monopro")
if (( arm64_only )); then
  [[ "$archs" == "arm64" ]]
else
  [[ " $archs " == *" arm64 "* ]]
  [[ " $archs " == *" x86_64 "* ]]
fi
codesign --verify --deep --strict "$app"
hdiutil verify "$dmg" >/dev/null
(( notarized )) && xcrun stapler validate "$dmg"

mount_point=$(mktemp -d "${TMPDIR:-/tmp}/monopro-dmg.XXXXXX")
mounted=0
cleanup() {
  (( mounted )) && hdiutil detach "$mount_point" >/dev/null
  rmdir "$mount_point" 2>/dev/null || true
}
trap cleanup EXIT
hdiutil attach "$dmg" -readonly -nobrowse -mountpoint "$mount_point" >/dev/null
mounted=1
test -d "$mount_point/monopro.app"
test -L "$mount_point/Applications"
test -f "$mount_point/LICENSE.txt"
test -f "$mount_point/READ ME FIRST.txt"
codesign --verify --deep --strict "$mount_point/monopro.app"

checksum="$dmg.sha256"
(
  cd "${dmg:h}"
  shasum -a 256 "${dmg:t}" > "${checksum:t}"
)
print -r -- "$dmg" "$checksum"
