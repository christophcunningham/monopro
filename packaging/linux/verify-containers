#!/usr/bin/env bash
# Check the AppImage's extracted payload against Fedora and Arch-family userspaces.
# This is an ABI/link check, not a substitute for a real Wayland desktop smoke test.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../.." && pwd)"
version="$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$repo_root/Cargo.toml" | head -n 1)"
artifact="${1:-$repo_root/dist/monopro-$version-linux-x86_64.AppImage}"

command -v docker >/dev/null || {
  echo "docker is required for the Linux compatibility checks." >&2
  exit 2
}
artifact="$(realpath "$artifact")"
test -x "$artifact"

for image in fedora:44 archlinux:base; do
  echo "checking $image"
  docker run --rm \
    --volume "$artifact:/tmp/monopro.AppImage:ro" \
    "$image" \
    /bin/bash -euc '
      mkdir /tmp/unpacked
      cd /tmp/unpacked
      /tmp/monopro.AppImage --appimage-extract >/dev/null
      library_path="$PWD/squashfs-root/usr/lib:$PWD/squashfs-root/usr/lib/x86_64-linux-gnu"
      if LD_LIBRARY_PATH="$library_path" ldd squashfs-root/usr/bin/monopro | grep -q "not found"; then
        LD_LIBRARY_PATH="$library_path" ldd squashfs-root/usr/bin/monopro >&2
        exit 1
      fi
    '
done
